<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear inherited sources so a machine-level nuget.config can't change the restore graph -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- BepInEx.Core, UnityEngine.Modules and Subnautica.*.GameLibs live here, not on nuget.org -->
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
