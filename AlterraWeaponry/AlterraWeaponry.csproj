<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>AlterraWeaponry</AssemblyName>
    <RootNamespace>VELD.AlterraWeaponry</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>

    <!-- Properties/AssemblyInfo.cs declares these by hand (it reads Main.modVers),
         so the SDK must not generate a second set of the same attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Game assemblies are Mono-built and ship no XML docs or strong names;
         these warnings are pure noise against them. -->
    <NoWarn>$(NoWarn);CS0436;MSB3277</NoWarn>

    <!-- BepInEx loads plugins from a flat folder, so keep the pre-SDK bin/<Config>/
         layout rather than the SDK's bin/<Config>/net472/. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- ==================== Game selection ==================== -->

  <!--
    Every configuration must pick a game. Several sources are only valid with one of
    the two defines set: Coal.Patch and PrawnSelfDefenseModule.Patch both wrap
    argument lists in #if BZ / #elif SN1 with no #else, so with neither define the
    argument list collapses to a trailing comma and the file stops parsing.

    BZ and SN1 pin the game; Debug and Release default to Below Zero (what mod.json
    targets) and can be flipped with -p:Game=Subnautica.
  -->
  <PropertyGroup>
    <Game Condition="'$(Configuration)' == 'BZ'">BelowZero</Game>
    <Game Condition="'$(Configuration)' == 'SN1'">Subnautica</Game>
    <Game Condition="'$(Game)' == ''">BelowZero</Game>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Game)' == 'BelowZero'">
    <DefineConstants>$(DefineConstants);BZ;BELOWZERO;BELOW_ZERO</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Game)' == 'Subnautica'">
    <DefineConstants>$(DefineConstants);SN1;SN;SUBNAUTICA</DefineConstants>
  </PropertyGroup>

  <Target Name="CheckGame" BeforeTargets="CoreCompile"
          Condition="'$(Game)' != 'BelowZero' And '$(Game)' != 'Subnautica'">
    <Error Code="AW0002" Text="Game must be 'BelowZero' or 'Subnautica', but was '$(Game)'." />
  </Target>

  <!-- ==================== Configurations ==================== -->

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- ==================== References ==================== -->

  <!--
    IncludeAssets="compile" on everything the game already provides. Without it these
    land in bin/ and get zipped into the release: BepInEx would then load stripped
    reference copies of Assembly-CSharp and Nautilus out of the plugin folder,
    shadowing the real ones. They are reference-only, never redistributed.
  -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" IncludeAssets="compile" />
    <PackageReference Include="UnityEngine.Modules" Version="2019.4.36" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <!-- Backfills the compiler-required types (IsExternalInit, RequiredMember, ...)
         that let C# 12 syntax compile against net472. -->
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Publicized game assemblies + the matching Nautilus build, per game.
       Both GameLibs packages carry Assembly-CSharp.dll, so exactly one may be
       referenced at a time; hence the per-game split. -->
  <ItemGroup Condition="'$(Game)' == 'BelowZero'">
    <PackageReference Include="Subnautica.BelowZero.GameLibs" Version="53115.0.0-r.0" IncludeAssets="compile" />
    <PackageReference Include="SubnauticaZero.Nautilus" Version="1.*-*" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup Condition="'$(Game)' == 'Subnautica'">
    <PackageReference Include="Subnautica.GameLibs" Version="82304.0.0-r.0" IncludeAssets="compile" />
    <PackageReference Include="Subnautica.Nautilus" Version="1.*-*" IncludeAssets="compile" />
    <PackageReference Include="Unity.InputSystem" Version="1.4.1" IncludeAssets="compile" />
  </ItemGroup>

  <!-- CuddleLibs is not on any NuGet feed; see CuddleLibsPath in Directory.Build.props. -->
  <ItemGroup Condition="Exists('$(CuddleLibsPath)')">
    <Reference Include="CuddleLibs">
      <HintPath>$(CuddleLibsPath)</HintPath>
      <!-- ships as its own BepInEx plugin, so it must not be copied next to this mod -->
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckCuddleLibs" BeforeTargets="CoreCompile" Condition="!Exists('$(CuddleLibsPath)')">
    <Error Code="AW0001"
           Text="CuddleLibs.dll was not found at '$(CuddleLibsPath)'. It is not published to NuGet, so copy it from a BepInEx install (BepInEx/plugins/CuddleLibs/CuddleLibs.dll) into '$(MSBuildThisFileDirectory)../libs/', or build with -p:CuddleLibsPath=/absolute/path/to/CuddleLibs.dll" />
  </Target>

  <!-- ==================== Content ==================== -->

  <ItemGroup>
    <None Include="mod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Localizations.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Main.Awake loads "<prefix>.alterraweaponry.assets" from the assembly directory,
       so the bundle for the targeted game has to land in the output folder. -->
  <ItemGroup>
    <None Include="bz.alterraweaponry.assets"
          Condition="'$(Game)' == 'BelowZero'"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="sn.alterraweaponry.assets"
          Condition="'$(Game)' == 'Subnautica'"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ==================== Packaging ==================== -->

  <Target Name="CopyLicense" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../LICENSE" DestinationFolder="$(OutDir)" />
  </Target>

  <!-- Debug only: push the built plugin straight into every game install listed,
       one absolute path per line, in AlterraWeaponry/game-dirs.txt (gitignored). -->
  <Target Name="CopyToModsDir" AfterTargets="CopyLicense"
          Condition="'$(Configuration)' == 'Debug' And Exists('game-dirs.txt')">
    <ReadLinesFromFile File="game-dirs.txt">
      <Output TaskParameter="Lines" ItemName="GameDirs" />
    </ReadLinesFromFile>
    <ItemGroup>
      <DeployFiles Include="$(OutDir)**/*" />
    </ItemGroup>
    <MakeDir Directories="@(GameDirs->'%(Identity)/BepInEx/plugins/$(MSBuildProjectName)')" />
    <!-- %(GameDirs.Identity) here batches the task once per listed install, passing
         the whole DeployFiles set each time. The output folder is flat, so
         DestinationFolder is enough. -->
    <Copy SourceFiles="@(DeployFiles)"
          DestinationFolder="%(GameDirs.Identity)/BepInEx/plugins/$(MSBuildProjectName)" />
  </Target>

  <!-- Release/BZ/SN1: stage the plugin under its own folder and zip it for upload. -->
  <Target Name="ZipDist" AfterTargets="CopyLicense"
          Condition="'$(Configuration)' != 'Debug'">
    <PropertyGroup>
      <DistRoot>$(MSBuildThisFileDirectory)bin/dist/$(Configuration)</DistRoot>
    </PropertyGroup>
    <ItemGroup>
      <DistFiles Include="$(OutDir)**/*" />
    </ItemGroup>
    <RemoveDir Directories="$(DistRoot)" />
    <Copy SourceFiles="@(DistFiles)"
          DestinationFiles="@(DistFiles->'$(DistRoot)/$(MSBuildProjectName)/%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(DistRoot)"
                  DestinationFile="$(MSBuildThisFileDirectory)bin/$(MSBuildProjectName).$(Configuration).zip"
                  Overwrite="true" />
  </Target>

</Project>
